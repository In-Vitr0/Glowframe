{
  "manifest_version": 3,
  "name": "Glowframe",
  "version": "2.0.0",
  "description": "Soft ambient light from the video colors around YouTube videos – with smooth transitions, presets and HDR light.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Glowframe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "quality.js",
        "hdr.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
